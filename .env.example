# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values before you build or run.
# .env already ships with the values for your Maatlaadu database, except the
# service-role key, which is a secret and is never stored in the code.
# ---------------------------------------------------------------------------

# Browser side (read at build time, embedded in the pages users download)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_pub..._...
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# Server side (read when the server runs)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_pub..._...
SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# Server side, required for the admin dashboard.
# This key can read every table, so keep it on the server only and never put it
# in a VITE_ variable or any file the browser loads.
# Find it in your Supabase dashboard: Project Settings -> API Keys ->
# service_role (click "Reveal"). Copy it exactly, it is long.
SUPABASE_SERVICE_ROLE_KEY=
